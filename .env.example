# Obligatorio, mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=

# Usuario admin inicial: solo se usa si la base está vacía.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@optidev.com
ADMIN_PASSWORD=

# Duración de la sesión web (minutos).
JWT_ACCESS_TTL_MINUTES=720

# Dashboard de GitHub y "Cargar en mi VM": token (classic con scope `repo`, o
# fine-grained con lectura de Contents, Pull requests, Commit statuses y Checks)
# de alguien con acceso a los repos. Contents hace falta para descargar ramas.
# La pestaña Workflow además necesita, sobre el repo de agentes, escritura de
# Contents y Pull requests (fine-grained) para abrir los PRs aprobados.
GITHUB_TOKEN=

# Pestaña Workflow: key del repo de agentes en el tablero, API key de Anthropic
# para el chat y modelo (por defecto Sonnet).
WORKFLOW_REPO_KEY=agents
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clave para cifrar las credenciales SSH de las VMs de pruebas (cualquier texto
# largo, ej. `openssl rand -hex 32`). Vacía = se deriva de JWT_SECRET. Cambiar
# la que esté en uso deja ilegibles las credenciales guardadas.
VM_CREDENTIALS_KEY=

# MFA (app de autenticación, TOTP). MFA_REQUIRED=true: quien no lo tiene lo
# registra al iniciar sesión. MFA_SECRET_KEY cifra los secretos (vacía = se
# deriva de JWT_SECRET); cambiarla invalida todos los MFA registrados.
MFA_REQUIRED=true
MFA_SECRET_KEY=

# Puerto del host publicado por docker-compose (nginx, HTTP). Dentro del
# contenedor nginx siempre escucha en el 80; esto solo cambia el mapeo del host.
FRONTEND_PORT=80

# Desarrollo local: puertos de uvicorn y de Vite (Vite hace proxy al backend).
# Vite no usa FRONTEND_PORT: un usuario sin root no puede abrir el puerto 80.
BACKEND_PORT=8000
VITE_DEV_PORT=5173
# Base de datos: MySQL 8 que corre aparte de este repo y se mantiene arriba por
# su cuenta. Con DB_HOST la URL se arma sola (contraseña con caracteres
# especiales: sin escapar). Con docker, si está publicada en el host:
# host.docker.internal; en desarrollo local fuera de docker: 127.0.0.1.
DB_DIALECT=mysql+aiomysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=optidev
DB_USER=optidev
DB_PASSWORD=
# Sin DB_HOST (solo fuera de docker) se usa DATABASE_URL o, si tampoco está,
# SQLite (tests y CI): sqlite+aiosqlite:///./data/optidev.db
